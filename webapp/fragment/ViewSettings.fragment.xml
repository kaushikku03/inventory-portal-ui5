<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <ViewSettingsDialog
        id="viewSettingsDialog"
        confirm=".onViewSettingsConfirm">
        <!-- SORT -->
        <sortItems>
            <ViewSettingsItem
                key="name"
                text="{i18n>name}"/>
            <ViewSettingsItem
                key="price"
                text="{i18n>price}"/>
            <ViewSettingsItem
                key="stock"
                text="{i18n>stock}"/>
        </sortItems>

        <!-- GROUP -->
        <groupItems>
            <ViewSettingsItem
                key="category"
                text="{i18n>category}"/>
        </groupItems>

        <!-- FILTER -->
        <filterItems>
            <ViewSettingsFilterItem
                key="status"
                text="{i18n>stockStatus}">
                <items>
                    <ViewSettingsItem
                        key="available"
                        text="{i18n>available}"/>

                    <ViewSettingsItem
                        key="low"
                        text="{i18n>lowStock}"/>

                    <ViewSettingsItem
                        key="out"
                        text="{i18n>outOfStock}"/>
                </items>
            </ViewSettingsFilterItem>
            <ViewSettingsFilterItem
                key="price"
                text="{i18n>price}">
                <items>
                    <ViewSettingsItem
                        key="0-50"
                        text="{i18n>priceRange1}"/>

                    <ViewSettingsItem
                        key="50-100"
                        text="{i18n>priceRange2}"/>

                    <ViewSettingsItem
                        key="100+"
                        text="{i18n>priceRange3}"/>
                </items>
            </ViewSettingsFilterItem>
        </filterItems>
    </ViewSettingsDialog>
</core:FragmentDefinition>