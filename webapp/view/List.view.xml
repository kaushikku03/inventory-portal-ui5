<mvc:View
    controllerName="inventory.portal.controller.List"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page
        id="listPage"
        title="{i18n>productsTitle}">
        <content>
            <Table
                id="productsTable"
                items="{products>/products}"
                updateFinished=".onUpdateFinished">
            <headerToolbar>
                <OverflowToolbar>
                    <Title
                        id="titleProducts"
                        text="{= ${i18n>inventoryProducts} + ' (' + ${view>/visibleCount} + ')' }"
                        level="H2"/>
                    <ToolbarSpacer/>
                    <SearchField
                        id="searchField"
                        width="15rem"
                        placeholder="{i18n>search}"
                        liveChange=".onSearch"/>
                    <Button
                        id="btnAdd"
                        icon="sap-icon://add"
                        text="{i18n>add}"
                        press=".onAdd"
                        type="Emphasized"/>
                    <Button
                        id="btnSort"
                        icon="sap-icon://sort"
                        tooltip="{i18n>sort}"
                        press=".onSort"/>
                    <Button
                        id="btnFilter"
                        icon="sap-icon://filter"
                        tooltip="{i18n>filter}"
                        press=".onFilter"/>
                    <Button
                        id="btnGroup"
                        icon="sap-icon://group-2"
                        tooltip="{i18n>group}"
                        press=".onGroup"/>
                </OverflowToolbar>
            </headerToolbar>
                <columns>
                    <Column
                        minScreenWidth="Tablet"
                        demandPopin="true"
                        hAlign="Center">
                        <Text text="{i18n>name}" textAlign="Center"/>
                    </Column>
                    <Column
                        minScreenWidth="Tablet"
                        demandPopin="true"
                        hAlign="Center">
                        <Text text="{i18n>category}" textAlign="Center"/>
                    </Column>
                    <Column
                        minScreenWidth="Tablet"
                        demandPopin="true"
                        hAlign="Center">
                        <Text text="{i18n>price}" textAlign="Center"/>
                    </Column>
                    <Column
                        hAlign="Center">
                        <Text text="{i18n>stock}"/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem
                        type="Navigation"
                        press=".onProductPress"
                        class="productRow">
                        <cells>
                            <Text text="{products>name}" textAlign="Center"/>
                            <Text text="{products>category}" textAlign="Center"/>
                            <ObjectNumber
                                number="{products>price}"
                                unit="{products>currency}"/>
                            <ObjectStatus
                                text="{
                                    path: 'products>stockStatus',
                                    formatter: '.formatter.stockText'
                                }"
                                state="{
                                    path: 'products>stockStatus',
                                    formatter: '.formatter.stockState'
                                }"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>