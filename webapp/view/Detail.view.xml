<mvc:View
    controllerName="inventory.portal.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form">

<Page
    title="{i18n>productDetails}"
    showNavButton="true"
    navButtonPress=".onNavBack">
    <content>
        <ObjectHeader
            title="{products>name}"
            number="{products>price}"
            numberUnit="{products>currency}"
            intro="{products>category}">

            <statuses>
                <ObjectStatus
                    text="{
                        path:'products>stockStatus',
                        formatter:'.formatter.stockText'
                    }"
                    state="{
                        path:'products>stockStatus',
                        formatter:'.formatter.stockState'
                    }"/>
            </statuses>

        </ObjectHeader>

        <!-- General Information -->

        <Panel
            headerText="{i18n>generalInformation}"
            expandable="false"
            class="sapUiResponsiveMargin">
            <form:SimpleForm
                editable="false"
                layout="ResponsiveGridLayout"
                columnsXL="2"
                columnsL="2"
                columnsM="1">
                <Label text="{i18n>description}"/>
                <Text text="{products>description}"/>

                <Label text="{i18n>supplier}"/>
                <ObjectIdentifier title="{products>supplier}"/>

                <Label text="{i18n>sku}"/>
                <ObjectIdentifier title="{products>sku}"/>

                <Label text="{i18n>warehouse}"/>
                <ObjectIdentifier title="{products>warehouse}"/>
            </form:SimpleForm>

        </Panel>

        <!-- Inventory Information -->
        <Panel
            headerText="{i18n>inventoryInformation}"
            expandable="false"
            class="sapUiResponsiveMargin">
            <HBox
                justifyContent="SpaceAround"
                renderType="Bare">
                <VBox alignItems="Center">
                    <Title text="{i18n>currentStock}"/>
                    <ObjectNumber
                        number="{products>stock}"
                        emphasized="true"/>
                </VBox>
                <VBox alignItems="Center">
                    <Title text="{i18n>reorderThreshold}"/>
                    <ObjectNumber
                        number="{products>reorderThreshold}"/>
                </VBox>
                <VBox alignItems="Center">
                    <Title text="{i18n>lastUpdated}"/>
                    <Text
                        text="{
                            path:'products>lastUpdated',
                            formatter:'.formatter.formatDate'
                        }"/>
                </VBox>
            </HBox>
        </Panel>
    </content>
    <footer>
        <OverflowToolbar>
            <ToolbarSpacer/>
            <Button
                text="{i18n>edit}"
                type="Emphasized"
                icon="sap-icon://edit"
                press=".onEdit"/>
            <Button
                text="{i18n>delete}"
                icon="sap-icon://delete"
                type="Reject"
                press=".onDelete"/>
            <Button
                text="{i18n>reorder}"
                icon="sap-icon://shipping-status"
                type="Accept"
                press=".onReorder"/>
        </OverflowToolbar>
    </footer>
</Page>
</mvc:View>